<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>LINQ</RootNamespace>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <Platforms>AnyCPU;x64</Platforms>
    <AutoGenerateBindingRedirects>True</AutoGenerateBindingRedirects>
    <UseApplicationFramework>True</UseApplicationFramework>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <Configurations>Debug;Release;MEMI-Desktop;Rsharp_app_release</Configurations>
    <PackageIcon>..\..\..\..\.pkg\icons8-repository-96.png</PackageIcon>
    <PackageOutputPath>..\..\..\..\.nuget</PackageOutputPath>
    <Title>Darwinism LINQ Query Runtime</Title>
    <PackageTags>linq;query-language;full-text;search;hpc;darwinism</PackageTags>
    <Description>A LINQ-style query language runtime and CLI that tokenizes .linq scripts and executes projection/filter queries against in-memory data, with full-text, term-hash, Levenshtein, and value-range searches via indexing types, shipping a CLI that outputs results as CSV or console tables.</Description>
    <PackageReleaseNotes>Initial GPL-3.0-only release of the Darwinism LINQ query language runtime component.</PackageReleaseNotes>
    <PackageProjectUrl>https://scibasic.net/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/xieguigang/Darwinism.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <Copyright>Copyright © scibasic.net foundation, GuiLin China, 2026</Copyright>
    <Authors>xieguigang&lt;xie.guigang@gmail.com&gt;</Authors>
    <Company>scibasic.net foundation</Company>
    <Product>Darwinism HPC</Product>
  </PropertyGroup>
