<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Darwinism.IPC.Networking</RootNamespace>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <AssemblyName>Darwinism.IPC.Networking</AssemblyName>
    <Configurations>Debug;Release;Rsharp_app_release;LipidSearch;PlantMAT;NPSearch;mzkit_win32;gcmodeller_desktop;Docker;CFD_win32;nuget_release;MEMI-Desktop;CellaLAB-Desktop</Configurations>
    <Platforms>AnyCPU;x64;x86</Platforms>
    <AutoGenerateBindingRedirects>True</AutoGenerateBindingRedirects>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageProjectUrl>https://scibasic.net/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/xieguigang/Darwinism.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageIcon>icons8-repository-96.png</PackageIcon>
    <PackageOutputPath>..\..\.nuget</PackageOutputPath>
    <Title>Darwinism IPC Networking Library</Title>
    <PackageTags>networking;tcp;socket;ipc;hpc;darwinism</PackageTags>
    <Description>Provides TCP/IP socket networking primitives for the Darwinism IPC layer, including an asynchronous multithreaded server socket, client/server wrappers, reflection-based protocol request handlers, an MMF-backed pipeline, HTTP crawling helpers, and CAPTCHA image generation.</Description>
    <PackageReleaseNotes>Initial GPL-3.0-only release of the Darwinism IPC networking component.</PackageReleaseNotes>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <Copyright>Copyright © scibasic.net foundation, GuiLin China, 2026</Copyright>
    <Authors>xieguigang&lt;xie.guigang@gmail.com&gt;</Authors>
    <Company>scibasic.net foundation</Company>
    <Product>Darwinism HPC</Product>
   
  </PropertyGroup>

