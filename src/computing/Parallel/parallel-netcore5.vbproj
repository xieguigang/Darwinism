<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Darwinism.HPC.Parallel</RootNamespace>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <AssemblyName>Darwinism.HPC.Parallel</AssemblyName>
    <Description>The Darwinism high-performance parallel compute library for .NET, implementing IPC-based parallel task execution across slave nodes, shared-memory (memory-mapped file) pipes for fast inter-process data exchange, and thread-pool task scheduling.</Description>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Copyright>Copyright © scibasic.net foundation, GuiLin China, 2026</Copyright>
    <Configurations>Debug;Release;Rsharp_app_release;mzkit_win32;gcmodeller_desktop;Docker;PlantMAT;MEMI-Desktop;CellaLAB-Desktop</Configurations>
    <Platforms>AnyCPU;x64</Platforms>
    <PackageProjectUrl>https://scibasic.net/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/xieguigang/Darwinism.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <Title>Darwinism HPC Parallel Library</Title>
    <Product>Darwinism HPC</Product>
    <PackageTags>parallel;ipc;hpc;darwinism;mmf</PackageTags>
    <Version>6.0.231.5699</Version>
    <Authors>xieguigang&lt;xie.guigang@gmail.com&gt;</Authors>
    <IncludeSymbols>True</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <OutputPath>../../../../../R-sharp/App/</OutputPath>
    <PackageIcon>..\..\..\.pkg\icons8-repository-96.png</PackageIcon>
    <PackageOutputPath>..\..\..\.nuget</PackageOutputPath>
    <PackageReleaseNotes>Initial GPL-3.0-only release of the Darwinism HPC parallel component.</PackageReleaseNotes>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <Company>scibasic.net foundation</Company>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <RemoveIntegerChecks>true</RemoveIntegerChecks>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <DefineConstants>netcore5=1,UNIX=1</DefineConstants>
    <DocumentationFile>Parallel.xml</DocumentationFile>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <RemoveIntegerChecks>true</RemoveIntegerChecks>
    <DebugSymbols>true</DebugSymbols>
