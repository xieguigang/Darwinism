<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Darwinism.Centos</RootNamespace>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <AssemblyName>Centos</AssemblyName>
    <Description>Helpers for remote Linux/CentOS management from .NET, including SSH and PuTTY (plink) automation, a bash command-interaction shell, common command parsers, and /proc/net/tcp and /proc/net/udp socket-table readers.</Description>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Copyright>Copyright © scibasic.net foundation, GuiLin China, 2026</Copyright>
    <Configurations>Debug;Release;Rsharp_app_release;LipidSearch;PlantMAT;NPSearch;mzkit_win32;CellaLAB-Desktop</Configurations>
    <Platforms>AnyCPU;x64</Platforms>
    <PackageProjectUrl>https://scibasic.net/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/xieguigang/Darwinism.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <Title>Darwinism CentOS Remote Helper</Title>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <IncludeSymbols>True</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <OutputPath>../../../assembly/</OutputPath>
    <PackageIcon>icons8-repository-96.png</PackageIcon>
    <PackageOutputPath>..\..\..\.nuget</PackageOutputPath>
    <PackageTags>centos;linux;ssh;hpc;darwinism</PackageTags>
    <PackageReleaseNotes>Initial GPL-3.0-only release of the Darwinism CentOS remote helper component.</PackageReleaseNotes>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <Authors>xieguigang&lt;xie.guigang@gmail.com&gt;</Authors>
    <Company>scibasic.net foundation</Company>
    <Product>Darwinism HPC</Product>
  </PropertyGroup>
