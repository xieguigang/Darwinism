<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <Platforms>AnyCPU;x64</Platforms>
    <Configurations>Debug;Release;LipidSearch;Rsharp_app_release;mzkit;gcmodeller_desktop;nuget_release</Configurations>
    <OutputType>Library</OutputType>
    <RootNamespace>Darwinism.IPC.OpenApi3</RootNamespace>
    <AssemblyName>Darwinism.IPC.OpenApi3.0</AssemblyName>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <AssemblyTitle>OpenApi3.0 Source Generator</AssemblyTitle>
    <UseApplicationFramework>True</UseApplicationFramework>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Title>OpenApi3.0 Source Generator</Title>
    <PackageTags>openapi;code-generator;ipc;hpc;darwinism</PackageTags>
    <Description>A VB.NET source generator that parses OpenAPI 3.0.1 documents and emits strongly-typed model classes, REST API client classes, and HTTP infrastructure from the spec's components/schemas and paths, for building typed IPC/API clients inside the Darwinism HPC stack.</Description>
    <PackageReleaseNotes>Initial GPL-3.0-only release of the Darwinism OpenAPI 3.0 source generator component.</PackageReleaseNotes>
    <PackageProjectUrl>https://scibasic.net/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/xieguigang/Darwinism.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <Copyright>Copyright © scibasic.net foundation, GuiLin China, 2026</Copyright>
    <Authors>xieguigang&lt;xie.guigang@gmail.com&gt;</Authors>
    <Company>scibasic.net foundation</Company>
    <Product>Darwinism HPC</Product>
    <PackageIcon>icons8-repository-96.png</PackageIcon>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net10.0|AnyCPU'">
    <OutputPath>G:\GCModeller\src\runtime\Darwinism\.nuget</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net10.0|x64'">
    <OutputPath>G:\GCModeller\src\runtime\Darwinism\.nuget</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net10.0|AnyCPU'">
    <OutputPath>G:\GCModeller\src\runtime\Darwinism\.nuget</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net10.0|x64'">
    <OutputPath>G:\GCModeller\src\runtime\Darwinism\.nuget</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='LipidSearch|net10.0|AnyCPU'">
    <OutputPath>G:\GCModeller\src\runtime\Darwinism\.nuget</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='LipidSearch|net10.0|x64'">
    <OutputPath>G:\GCModeller\src\runtime\Darwinism\.nuget</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Rsharp_app_release|net10.0|AnyCPU'">
    <OutputPath>G:\GCModeller\src\runtime\Darwinism\.nuget</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Rsharp_app_release|net10.0|x64'">
    <OutputPath>G:\GCModeller\src\runtime\Darwinism\.nuget</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='mzkit|net10.0|AnyCPU'">
    <OutputPath>G:\GCModeller\src\runtime\Darwinism\.nuget</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='mzkit|net10.0|x64'">
    <OutputPath>G:\GCModeller\src\runtime\Darwinism\.nuget</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='gcmodeller_desktop|net10.0|AnyCPU'">
    <OutputPath>G:\GCModeller\src\runtime\Darwinism\.nuget</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='gcmodeller_desktop|net10.0|x64'">
    <OutputPath>G:\GCModeller\src\runtime\Darwinism\.nuget</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='nuget_release|net10.0|AnyCPU'">
    <OutputPath>G:\GCModeller\src\runtime\Darwinism\.nuget</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='nuget_release|net10.0|x64'">
    <OutputPath>G:\GCModeller\src\runtime\Darwinism\.nuget</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Generator\**" />
    <EmbeddedResource Remove="Generator\**" />
    <None Remove="Generator\**" />
    <None Include="..\..\..\.pkg\icons8-repository-96.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\..\sciBASIC#\Microsoft.VisualBasic.Core\src\Core.vbproj" />
    <ProjectReference Include="..\..\..\..\sciBASIC#\mime\text%yaml\text.yaml.vbproj" />
  </ItemGroup>
</Project>