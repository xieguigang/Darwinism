<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Darwinism.DataScience.DataMining</RootNamespace>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <AssemblyName>Darwinism.DataScience.DataMining</AssemblyName>
    <Platforms>AnyCPU;x64</Platforms>
    <Configurations>Debug;Release;Rsharp_app_release</Configurations>
    <OutputPath>../../../assembly/</OutputPath>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageIcon>..\..\..\.pkg\icons8-repository-96.png</PackageIcon>
    <PackageOutputPath>..\..\..\.nuget</PackageOutputPath>
    <Title>Darwinism Data Mining Library</Title>
    <PackageTags>datamining;clustering;knn;hpc;darwinism</PackageTags>
    <Description>A data-mining library for the Darwinism framework providing parallel K-nearest-neighbor search, Pearson correlation network construction, genetic-algorithm scaffolding, and typed file serializers for vector and neighbor data.</Description>
    <PackageReleaseNotes>Initial GPL-3.0-only release of the Darwinism data-mining component.</PackageReleaseNotes>
    <PackageProjectUrl>https://scibasic.net/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/xieguigang/Darwinism.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <Copyright>Copyright © scibasic.net foundation, GuiLin China, 2026</Copyright>
    <Authors>xieguigang&lt;xie.guigang@gmail.com&gt;</Authors>
    <Company>scibasic.net foundation</Company>
    <Product>Darwinism HPC</Product>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\..\.pkg\icons8-repository-96.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\..\sciBASIC#\Data\BinaryData\BinaryData\binarydata-netcore5.vbproj" />
    <ProjectReference Include="..\..\..\..\sciBASIC#\Data\BinaryData\DataStorage\datastorage-netcore5.vbproj" />
    <ProjectReference Include="..\..\..\..\sciBASIC#\Data\BinaryData\msgpack\msgpack-netcore5.vbproj" />
    <ProjectReference Include="..\..\..\..\sciBASIC#\Data\DataFrame\dataframework-netcore5.vbproj" />
    <ProjectReference Include="..\..\..\..\sciBASIC#\Data_science\DataMining\DataMining\DataMining.NET5.vbproj" />
    <ProjectReference Include="..\..\..\..\sciBASIC#\Data_science\Graph\graph-netcore5.vbproj" />
    <ProjectReference Include="..\..\..\..\sciBASIC#\Data_science\MachineLearning\MachineLearning\machine_learning-netcore5.vbproj" />
    <ProjectReference Include="..\..\..\..\sciBASIC#\Data_science\Mathematica\Math\Math\Math.NET5.vbproj" />
    <ProjectReference Include="..\..\..\..\sciBASIC#\Microsoft.VisualBasic.Core\src\Core.vbproj" />
    <ProjectReference Include="..\..\..\..\sciBASIC#\mime\application%json\JSON-netcore5.vbproj" />
    <ProjectReference Include="..\..\computing\batch\batch.vbproj" />
    <ProjectReference Include="..\..\computing\Parallel\parallel-netcore5.vbproj" />
  </ItemGroup>
</Project>